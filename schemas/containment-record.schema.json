{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huffman:cas-xdp:containment-record:1.0",
  "title": "CAS-XDP POSIX Containment Outcome Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation_id", "operation", "plan_sha256",
    "status", "artifact_sha256", "target_relative", "rollback_reference",
    "related_operation_id", "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "operation_id": { "type": "string", "format": "uuid" },
    "operation": { "enum": ["quarantine", "restore"] },
    "plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "const": "verified" },
    "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_relative": { "type": "string", "minLength": 1 },
    "rollback_reference": { "type": "string", "minLength": 1 },
    "related_operation_id": { "type": "string" },
    "recorded_at": { "type": "string", "format": "date-time" }
  }
}
